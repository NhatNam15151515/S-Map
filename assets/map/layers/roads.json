    "minzoom": 4,
    "filter": [
      "any",
      [
        "==",
        [
          "get",
          "class"
        ],
        "motorway"
      ],
      [
        "==",
        [
          "get",
          "class"
        ],
        "trunk"
      ]
    ],
    "layout": {
      "line-cap": "round",
      "line-join": "round"
    },
    "paint": {
      "line-color": "__ROAD_SURFACE__",
      "line-opacity": "__ROAD_SURFACE_OPACITY__",
      "line-width": [
        "interpolate",
        [
          "linear"
        ],
        [
          "zoom"
        ],
        4,
        0.5,
        8,
        1.5,
        12,
        4.0,
        14,
        7.2,
        16,
        10.5,
        23,
        50.5
      ]
    }
  },
  // ─── 2.3. Mặt lòng đường trục chính / tỉnh lộ lớn (primary) ───
  {
    "id": "smap-road-surface-primary",
    "type": "line",
    "source": "smap-vietnam",
    "source-layer": "transportation",
    "minzoom": 6,
    "filter": [
      "==",
      [
        "get",
        "class"
      ],
      "primary"
    ],
    "layout": {
      "line-cap": "round",
      "line-join": "round"
    },
    "paint": {
      "line-color": "__ROAD_SURFACE__",
      "line-opacity": "__ROAD_SURFACE_OPACITY__",
      "line-width": [
        "interpolate",
        [
          "linear"
        ],
        [
          "zoom"
        ],
        4,
        0.45,
        8,
        1.35,
        12,
        3.4,
        14,
        6.1,
        16,
        10.5,
        23,
        50.5
      ]
    }
  },
  // ─── 2.4. Mặt lòng đường nhánh cấp 2 / liên huyện (secondary) ───
