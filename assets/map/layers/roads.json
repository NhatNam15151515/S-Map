        ],
        [
          "zoom"
        ], // [Cấp zoom, Độ dày px]:
        4,
        0.3,
        8,
        0.8,
        12,
        0.7,
        14,
        2.0,
        16,
        5.2,
        23,
        50.5
      ]
    }
  },
  // ─── 2.2. Mặt lòng đường cao tốc & quốc lộ chính (motorway, trunk) ───
  {
