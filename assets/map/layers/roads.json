  // =========================================================================
  // NHÓM 3: VẠCH KẺ TIM ĐƯỜNG PHÂN LÀN (ROAD CENTERLINE / LANE DIVIDER)
  // Chỉ xuất hiện ở những mức zoom to cuối cùng (zoom 16+), nét nhỏ mảnh tinh tế
  // =========================================================================
  {
    "id": "smap-road-centerline",
    "type": "line",
    "source": "smap-vietnam",
    "source-layer": "transportation",
    "minzoom": 16, // Chỉ hiện ở những mức zoom to cuối cùng cận cảnh
    "filter": [
      "all",
      [
        "!=",
        [
          "get",
          "oneway"
        ],
        1
      ],
      [
        "!=",
        [
          "get",
          "oneway"
        ],
        "1"
      ],
      [
        "!=",
        [
          "get",
          "oneway"
        ],
        "yes"
      ],
      [
        "match",
        [
          "get",
          "class"
        ],
        [
          "motorway",
          "trunk",
          "primary",
          "secondary"
        ],
        true,
        false
      ]
    ],
    "layout": {
      "line-cap": "butt", // Đầu gạch phẳng dứt khoát
      "line-join": "round"
    },
    "paint": {
      "line-color": "__LABEL_PRIMARY__", // Màu tương phản cao (#374151 ở Light, #CBD6E0 ở Dark)
      "line-opacity": 0.75,
      "line-dasharray": [
        3,
        4
      ], // [độ dài vạch sơn, khoảng cách trống]
      "line-width": [
        "interpolate",
        [
          "linear"
        ],
        [
          "zoom"
        ],
        16,
        0.5, // Nét mảnh nhỏ tinh tế, không chiếm lòng đường
        18,
        0.8,
        19,
        1.1
      ]
    }
  },
  // =========================================================================
  // NHÓM 4: MŨI TÊN CHỈ HƯỚNG ĐƯỜNG MỘT CHIỀU (ONE-WAY TRAFFIC ARROWS)
  // Mũi tên có đuôi (→ / ←), căn chuẩn chính giữa tim đường, màu tương phản cao
  // =========================================================================
  {
    "id": "smap-road-oneway-arrow",
    "type": "symbol",
    "source": "smap-vietnam",
    "source-layer": "transportation",
    "minzoom": 16, // Đồng bộ chỉ hiện ở những mức zoom to cuối cùng
    "filter": [
      "all",
      [
        "any",
        [
          "==",
          [
            "get",
            "oneway"
          ],
          1
        ],
        [
          "==",
          [
            "get",
            "oneway"
          ],
          "1"
        ],
        [
          "==",
          [
            "get",
            "oneway"
          ],
          "yes"
        ],
        [
          "==",
          [
            "get",
            "oneway"
          ],
          -1
        ],
        [
          "==",
          [
            "get",
            "oneway"
          ],
          "-1"
        ]
      ],
      [
        "!=",
        [
          "get",
          "class"
        ],
        "path"
      ],
      [
        "!=",
        [
          "get",
          "class"
        ],
        "pedestrian"
      ],
      [
        "!=",
        [
          "get",
          "class"
        ],
        "steps"
      ]
    ],
    "layout": {
      "symbol-placement": "line", // Mũi tên uốn lượn chạy dọc theo tim đường
      "symbol-spacing": 95, // Mật độ đều đặn, không bị rối
      "text-field": [
        "case",
        [
          "any",
          [
            "==",
            [
              "get",
              "oneway"
            ],
            -1
          ],
          [
            "==",
            [
              "get",
              "oneway"
            ],
            "-1"
          ]
        ],
        "←",
        "→"
      ],
      "text-font": [
        "Montserrat Regular"
      ],
      "text-size": [
        "interpolate",
        [
          "linear"
        ],
        [
          "zoom"
        ],
        16,
        13.0,
        18,
        16.0,
        19,
        19.0
      ],
      "text-offset": [
        0,
        -0.09
      ], // Bù trừ độ lệch baseline font giúp mũi tên nằm chuẩn chính giữa tim đường
      "text-keep-upright": false, // Bắt buộc false để mũi tên luôn chỉ theo chiều xe chạy
      "text-allow-overlap": true, // Cho phép hiện cùng tên đường, không bị collision nuốt mất
      "text-ignore-placement": true
    },
    "paint": {
      "text-color": "__LABEL_PRIMARY__", // Màu tương phản cao (#374151 ở Light, #CBD6E0 ở Dark)
      "text-halo-color": "__ROAD_SURFACE__", // Halo viền phát quang tiệp màu lòng đường giúp sắc cạnh
      "text-halo-width": 1.0,
      "text-opacity": 0.95
    }
  }
]