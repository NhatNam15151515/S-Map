[
  // =========================================================================
  // NHÓM 1: LỚP VIỀN MÉP ĐƯỜNG (ROAD CASING - VẼ DƯỚI, NÉT TO HƠN)
  // Quy tắc: Luôn giữ width(casing) > width(surface) để tạo viền hai bên mép đường.
  // =========================================================================
  // ─── 1.1. Viền đường ngõ hẻm / dân sinh nội bộ ───
  {
    "id": "smap-road-casing",
    "type": "line",
    "source": "smap-vietnam",
    "source-layer": "transportation",
    "minzoom": 11, // Cấp zoom tối thiểu để hiện đường hẻm
    "layout": {
      "line-cap": "round", // Bo tròn 2 đầu mút đường
      "line-join": "round" // Bo tròn các khúc cua nối nhau
    },
    "paint": {
      "line-color": "__ROAD_CASING__", // Màu viền mép đường (từ palette)
      "line-opacity": "__ROAD_CASING_OPACITY__", // Độ mờ viền (từ palette)
      "line-width": [
        "interpolate",
        [
          "linear"
        ],
        [
          "zoom"
        ], // [Cấp zoom, Độ dày px]:
        4,
        0.5,
        8,
        1.1,
        12,
        1.4,
        14,
        3.0,
        16,
        7.2,
        23,
        51.5
      ]
    }
  },
  // ─── 1.2. Viền đường cao tốc & quốc lộ chính (motorway, trunk) ───
  {
    "id": "smap-road-casing-major",
    "type": "line",
    "source": "smap-vietnam",
    "source-layer": "transportation",
    "minzoom": 4, // Hiện từ zoom xa (zoom 4)
    "filter": [
      "any",
      [
        "==",
        [
          "get",
          "class"
        ],
        "motorway"
      ], // Cao tốc
      [
        "==",
        [
          "get",
          "class"
        ],
        "trunk"
      ] // Quốc lộ chính
    ],
    "layout": {
      "line-cap": "round",
      "line-join": "round"
    },
    "paint": {
      "line-color": "__ROAD_CASING__",
      "line-opacity": "__ROAD_CASING_OPACITY__",
      "line-width": [
        "interpolate",
        [
          "linear"
        ],
        [
          "zoom"
        ],
        4,
        0.9,
        8,
        2.0,
        12,
        5.2,
        14,
        8.5,
        16,
        11.0,
        23,
        51.5
      ]
    }
  },
  // ─── 1.3. Viền đường trục chính / tỉnh lộ lớn (primary) ───
  {
    "id": "smap-road-casing-primary",
    "type": "line",
    "source": "smap-vietnam",
    "source-layer": "transportation",
    "minzoom": 6, // Hiện từ zoom 6
    "filter": [
      "==",
      [
        "get",
        "class"
      ],
      "primary"
    ],
    "layout": {
      "line-cap": "round",
      "line-join": "round"
    },
    "paint": {
      "line-color": "__ROAD_CASING__",
      "line-opacity": "__ROAD_CASING_OPACITY__",
      "line-width": [
        "interpolate",
        [
          "linear"
        ],
        [
          "zoom"
        ],
        4,
        0.8,
        8,
        1.8,
        12,
        4.4,
        14,
        7.4,
        16,
        11.0,
        23,
        51.5
      ]
    }
  },
  // ─── 1.4. Viền đường nhánh cấp 2 / liên huyện (secondary) ───
  {
    "id": "smap-road-casing-secondary",
    "type": "line",
    "source": "smap-vietnam",
    "source-layer": "transportation",
    "minzoom": 8, // Hiện từ zoom 8
    "filter": [
      "==",
      [
        "get",
        "class"
      ],
      "secondary"
    ],
    "layout": {
      "line-cap": "round",
      "line-join": "round"
    },
    "paint": {
      "line-color": "__ROAD_CASING__",
      "line-opacity": "__ROAD_CASING_OPACITY__",
      "line-width": [
        "interpolate",
        [
          "linear"
        ],
        [
          "zoom"
        ],
        4,
        0.7,
        8,
        1.5,
        12,
        3.8,
        14,
        5.3,
        16,
        11.0,
        23,
        51.5
      ]
    }
  },
  // ─── 1.5. Viền đường liên xã / đô thị nhỏ (tertiary) ───
  {
    "id": "smap-road-casing-tertiary",
    "type": "line",
    "source": "smap-vietnam",
    "source-layer": "transportation",
    "minzoom": 10, // Hiện từ zoom 10
    "filter": [
      "==",
      [
        "get",
        "class"
      ],
      "tertiary"
    ],
    "layout": {
      "line-cap": "round",
      "line-join": "round"
    },
    "paint": {
      "line-color": "__ROAD_CASING__",
      "line-opacity": "__ROAD_CASING_OPACITY__",
      "line-width": [
        "interpolate",
        [
          "linear"
        ],
        [
          "zoom"
        ],
        4,
        0.6,
        8,
        1.3,
        12,
        3.2,
        14,
        5.4,
        16,
        11.0,
        23,
        51.5
      ]
    }
  },
  // =========================================================================
  // NHÓM 2: LỚP MẶT LÒNG ĐƯỜNG (ROAD SURFACE - VẼ ĐÈ LÊN TRÊN, NÉT NHỎ HƠN)
  // Màu chính giữa của đường xe chạy.
  // =========================================================================
  // ─── 2.1. Mặt lòng đường ngõ hẻm / dân sinh nội bộ ───
  {
    "id": "smap-road-surface",
    "type": "line",
    "source": "smap-vietnam",
    "source-layer": "transportation",
    "minzoom": 11,
    "layout": {
      "line-cap": "round",
      "line-join": "round"
    },
    "paint": {
      "line-color": "__ROAD_SURFACE__", // Màu mặt lòng đường
      "line-opacity": "__ROAD_SURFACE_OPACITY__", // Độ mờ mặt đường
      "line-width": [
        "interpolate",
        [
