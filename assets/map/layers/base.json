    },
    // Nguồn dữ liệu GeoJSON khẳng định chủ quyền Hoàng Sa, Trường Sa, Biển Đông
    "smap-sovereignty-source": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": [
          {
            "type": "Feature",
