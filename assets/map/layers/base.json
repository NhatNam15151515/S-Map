          },
          {
            "type": "Feature",
            "geometry": {
              "type": "Point",
              "coordinates": [111.9197, 8.6433]
            },
            "properties": {
              "name": "Quần đảo Trường Sa\n(Việt Nam)",
              "textSize": 13,
              "textColor": "#D32F2F",
              "letterSpacing": 0
            }
          },
          {
            "type": "Feature",
            "geometry": {
              "type": "Point",
              "coordinates": [113.5, 13.5]
            },
            "properties": {
              "name": "BIỂN ĐÔNG",
