        "text-halo-width": 1.3
      }
    },
    {
      "id": "smap-poi-markers",
      "type": "symbol",
      "metadata": {
        "comment": "Biểu tượng và tên địa điểm POI badges theo category khi zoom 17-22"
      },
      "source": "smap-vietnam",
      "source-layer": "poi",
      "minzoom": 17,
      "filter": ["has", "name"],
      "layout": {
        "icon-image": [
          "match",
          ["get", "class"],
          ["cafe", "coffee"], "poi-marker-cafe",
          ["restaurant", "fast_food", "food"], "poi-marker-food",
          ["hotel", "motel", "lodging", "hostel", "guest_house"], "poi-marker-hotel",
          ["supermarket", "grocery"], "poi-marker-supermarket",
          ["shop", "convenience", "mall", "department_store", "clothes", "electronics", "bakery"], "poi-marker-shop",
          ["fuel", "gas"], "poi-marker-fuel",
          ["bank", "atm"], "poi-marker-bank",
          ["hospital", "pharmacy", "clinic", "doctors"], "poi-marker-hospital",
          ["school", "university", "college", "kindergarten"], "poi-marker-school",
          ["park", "pitch", "sports_centre"], "poi-marker-park",
          "poi-marker-default"
        ],
        "icon-size": [
          "interpolate", ["linear"], ["zoom"],
          17, 0.48,
          19, 0.58,
          22, 0.72
        ],
        "icon-anchor": "bottom",
        "icon-allow-overlap": false,
        "icon-ignore-placement": false,
        "text-field": [
          "coalesce",
          ["get", "name:vi"],
          ["get", "name"]
        ],
        "text-font": ["Montserrat Regular"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          17, 10.0,
          19, 11.5,
          22, 13.0
