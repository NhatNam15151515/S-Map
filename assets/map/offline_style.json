        "text-padding": 2,
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "__LABEL_PRIMARY__",
        "text-halo-color": "__LABEL_HALO__",
        "text-halo-width": 1.8,
        "text-halo-blur": 0.1
