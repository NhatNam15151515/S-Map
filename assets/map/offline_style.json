    {
      "id": "smap-road-centerline",
      "type": "line",
      "metadata": {
        "comment": "Vạch kẻ tim đường phân làn nét đứt (Centerline)"
      },
      "source": "smap-vietnam",
      "source-layer": "transportation",
      "minzoom": 16,
      "filter": [
        "all",
        ["!=", ["get", "oneway"], 1],
        ["!=", ["get", "oneway"], "1"],
        ["!=", ["get", "oneway"], "yes"],
        [
          "match",
          ["get", "class"],
          ["motorway", "trunk", "primary", "secondary"],
          true,
          false
        ]
      ],
      "layout": {"line-cap": "butt", "line-join": "round"},
      "paint": {
        "line-color": "__LABEL_PRIMARY__",
        "line-opacity": 0.75,
        "line-dasharray": [3, 4],
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          16, 0.5,
          18, 0.8,
          19, 1.1
        ]
      }
    },
    {
      "id": "smap-road-oneway-arrow",
      "type": "symbol",
      "metadata": {
        "comment": "Mũi tên chỉ hướng đường 1 chiều như Google Maps"
      },
      "source": "smap-vietnam",
      "source-layer": "transportation",
      "minzoom": 16,
      "filter": [
        "all",
        [
          "any",
          ["==", ["get", "oneway"], 1],
          ["==", ["get", "oneway"], "1"],
          ["==", ["get", "oneway"], "yes"],
          ["==", ["get", "oneway"], -1],
          ["==", ["get", "oneway"], "-1"]
        ],
        ["!=", ["get", "class"], "path"],
        ["!=", ["get", "class"], "pedestrian"],
        ["!=", ["get", "class"], "steps"]
      ],
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 95,
        "text-field": [
          "case",
          ["any", ["==", ["get", "oneway"], -1], ["==", ["get", "oneway"], "-1"]],
          "←",
          "→"
        ],
        "text-font": ["Montserrat Regular"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          16, 13.0,
          18, 16.0,
          19, 19.0
        ],
        "text-offset": [0, -0.09],
        "text-keep-upright": false,
        "text-allow-overlap": true,
        "text-ignore-placement": true
      },
      "paint": {
        "text-color": "__LABEL_PRIMARY__",
        "text-halo-color": "__ROAD_SURFACE__",
        "text-halo-width": 1.0,
        "text-opacity": 0.95
      }
    },
    {
      "id": "smap-road-labels",
