      },
      "paint": {"background-color": "__MAP_BACKGROUND__"}
    },
    {
      "id": "smap-landcover",
      "type": "fill",
      "metadata": {
        "comment": "Thảm thực vật tự nhiên (rừng cây, đồng cỏ, bụi rậm, đầm lầy)"
      },
      "source": "smap-vietnam",
      "source-layer": "landcover",
      "minzoom": 7,
      "paint": {
        "fill-color": [
          "match", ["get", "class"],
          "wood", "__LAND_WOOD__",
          "forest", "__LAND_WOOD__",
          "grass", "__LAND_GRASS__",
          "scrub", "__LAND_SCRUB__",
          "wetland", "__LAND_WETLAND__",
          "__LAND_DEFAULT__"
        ],
        "fill-opacity": 0.72
      }
    },
    {
      "id": "smap-landuse",
      "type": "fill",
      "metadata": {
        "comment": "Quy hoạch sử dụng đất (khu dân cư, thương mại, công nghiệp, nghĩa trang, quân sự)"
      },
      "source": "smap-vietnam",
      "source-layer": "landuse",
      "minzoom": 5,
      "paint": {
        "fill-color": [
          "match", ["get", "class"],
          "residential", "__LAND_RESIDENTIAL__",
          "commercial", "__LAND_COMMERCIAL__",
          "industrial", "__LAND_INDUSTRIAL__",
          "cemetery", "__LAND_CEMETERY__",
          "military", "__LAND_MILITARY__",
          "__LANDUSE_DEFAULT__"
        ],
        "fill-opacity": 0.60
      }
    },
    {
      "id": "smap-parks",
      "type": "fill",
      "metadata": {
        "comment": "Công viên, vườn hoa, mảng xanh đô thị"
      },
      "source": "smap-vietnam",
      "source-layer": "park",
      "minzoom": 6,
      "paint": {
        "fill-color": "__PARK_FILL__",
        "fill-outline-color": "__PARK_OUTLINE__",
        "fill-opacity": 0.76
      }
    },
    {
      "id": "smap-water",
      "type": "fill",
      "metadata": {
        "comment": "Mặt nước lớn (sông, hồ, vịnh, biển)"
      },
      "source": "smap-vietnam",
      "source-layer": "water",
      "paint": {
        "fill-color": "__WATER_FILL__",
        "fill-outline-color": "__WATER_OUTLINE__"
      }
    },
    {
      "id": "smap-waterway",
      "type": "line",
      "metadata": {
        "comment": "Kênh rạch, suối nhỏ (vẽ dạng nét line)"
      },
      "source": "smap-vietnam",
      "source-layer": "waterway",
      "minzoom": 8,
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "__WATERWAY_LINE__",
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          8, 0.5, 12, 1.4, 14, 2.4
