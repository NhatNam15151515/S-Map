{
  "version": 8,
  "name": "S-Map Offline Minimal",
  "metadata": {
    "smap:purpose": "offline-vietnam-vector-map",
    "smap:labels": "local-font-faces"
  },
  "font-faces": {
    "Montserrat Regular": "__FONT_URL__"
  },
  "sources": {
    "smap-vietnam": {
      "type": "vector",
      "url": "pmtiles://__PMTILES_URI__",
      "bounds": [102.1, 8.5, 109.5, 23.4],
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "smap-background",
      "type": "background",
      "paint": {"background-color": "__MAP_BACKGROUND__"}
    },
    {
      "id": "smap-landcover",
      "type": "fill",
      "source": "smap-vietnam",
      "source-layer": "landcover",
      "minzoom": 7,
      "paint": {
        "fill-color": [
          "match", ["get", "class"],
          "wood", "__LAND_WOOD__",
          "forest", "__LAND_WOOD__",
          "grass", "__LAND_GRASS__",
          "scrub", "__LAND_SCRUB__",
          "wetland", "__LAND_WETLAND__",
          "__LAND_DEFAULT__"
        ],
        "fill-opacity": 0.72
      }
    },
    {
      "id": "smap-landuse",
      "type": "fill",
      "source": "smap-vietnam",
      "source-layer": "landuse",
      "minzoom": 5,
      "paint": {
        "fill-color": [
          "match", ["get", "class"],
          "residential", "__LAND_RESIDENTIAL__",
          "commercial", "__LAND_COMMERCIAL__",
          "industrial", "__LAND_INDUSTRIAL__",
          "cemetery", "__LAND_CEMETERY__",
          "military", "__LAND_MILITARY__",
          "__LANDUSE_DEFAULT__"
        ],
        "fill-opacity": 0.60
      }
    },
    {
      "id": "smap-parks",
      "type": "fill",
      "source": "smap-vietnam",
      "source-layer": "park",
      "minzoom": 6,
      "paint": {
        "fill-color": "__PARK_FILL__",
        "fill-outline-color": "__PARK_OUTLINE__",
        "fill-opacity": 0.76
      }
    },
    {
      "id": "smap-water",
      "type": "fill",
      "source": "smap-vietnam",
      "source-layer": "water",
      "paint": {
        "fill-color": "__WATER_FILL__",
        "fill-outline-color": "__WATER_OUTLINE__"
      }
    },
    {
      "id": "smap-waterway",
      "type": "line",
      "source": "smap-vietnam",
      "source-layer": "waterway",
      "minzoom": 8,
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "__WATERWAY_LINE__",
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          8, 0.5, 12, 1.4, 14, 2.4
        ]
      }
    },
    {
      "id": "smap-boundaries",
      "type": "line",
      "source": "smap-vietnam",
      "source-layer": "boundary",
      "minzoom": 4,
      "paint": {
        "line-color": "__BOUNDARY_LINE__",
        "line-opacity": 0.78,
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          4, 0.6, 10, 1.1, 14, 1.8
        ],
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "smap-aeroway-fill",
      "type": "fill",
      "source": "smap-vietnam",
      "source-layer": "aeroway",
      "minzoom": 10,
      "paint": {
        "fill-color": "__AEROWAY_FILL__",
        "fill-opacity": 0.72
      }
    },
    {
      "id": "smap-aeroway-line",
      "type": "line",
      "source": "smap-vietnam",
      "source-layer": "aeroway",
      "minzoom": 10,
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "__AEROWAY_LINE__",
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          10, 0.6, 14, 2.2
        ]
      }
    },
    {
      "id": "smap-buildings",
      "type": "fill",
      "source": "smap-vietnam",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "__BUILDING_FILL__",
        "fill-outline-color": "__BUILDING_OUTLINE__",
        "fill-opacity": 0.90
      }
    },
    {
      "id": "smap-road-casing",
      "type": "line",
      "source": "smap-vietnam",
      "source-layer": "transportation",
      "minzoom": 4,
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "__ROAD_CASING__",
        "line-opacity": 0.94,
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          4, 0.8, 8, 1.8, 12, 4.2, 14, 8.0
        ]
      }
    },
    {
      "id": "smap-road-surface",
      "type": "line",
      "source": "smap-vietnam",
      "source-layer": "transportation",
      "minzoom": 4,
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": [
          "match", ["get", "class"],
          "motorway", "__ROAD_MOTORWAY__",
          "trunk", "__ROAD_TRUNK__",
          "primary", "__ROAD_PRIMARY__",
          "secondary", "__ROAD_SECONDARY__",
          "tertiary", "__ROAD_TERTIARY__",
          "minor", "__ROAD_MINOR__",
          "service", "__ROAD_SERVICE__",
          "track", "__ROAD_TRACK__",
          "__ROAD_DEFAULT__"
        ],
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          4, 0.45, 8, 1.0, 12, 2.6, 14, 5.5
        ]
      }
    },
    {
      "id": "smap-road-labels",
      "type": "symbol",
      "source": "smap-vietnam",
      "source-layer": "transportation_name",
      "minzoom": 10,
      "filter": ["has", "name"],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          ["get", "name:vi"],
          ["get", "name"]
        ],
        "text-font": ["Montserrat Regular"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          10, 9,
          14, 13
        ],
        "text-max-width": 7,
        "text-padding": 2,
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "__LABEL_SECONDARY__",
        "text-halo-color": "__LABEL_HALO__",
        "text-halo-width": 1.4,
        "text-halo-blur": 0.1
      }
    },
    {
      "id": "smap-places",
      "type": "circle",
      "source": "smap-vietnam",
      "source-layer": "place",
      "minzoom": 5,
      "paint": {
        "circle-color": "__PLACE_DOT__",
        "circle-opacity": 0.82,
        "circle-radius": [
          "interpolate", ["linear"], ["zoom"],
          5, 1.2, 9, 2.2, 14, 3.2
        ],
        "circle-stroke-color": "__PLACE_STROKE__",
        "circle-stroke-width": 1
      }
    },
    {
      "id": "smap-place-labels",
      "type": "symbol",
      "source": "smap-vietnam",
      "source-layer": "place",
      "minzoom": 5,
      "filter": ["has", "name"],
      "layout": {
        "text-field": [
          "coalesce",
          ["get", "name:vi"],
          ["get", "name"]
        ],
        "text-font": ["Montserrat Regular"],
        "text-size": [
          "step", ["zoom"],
          9,
          8, 11,
          11, 13,
          13, 15
        ],
        "text-offset": [0, 0.8],
        "text-padding": 2,
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "__LABEL_PRIMARY__",
        "text-halo-color": "__LABEL_HALO__",
        "text-halo-width": 1.8,
        "text-halo-blur": 0.1
      }
    },
    {
      "id": "smap-water-labels",
      "type": "symbol",
      "source": "smap-vietnam",
      "source-layer": "water_name",
      "minzoom": 8,
      "filter": ["has", "name"],
      "layout": {
        "text-field": [
          "coalesce",
          ["get", "name:vi"],
          ["get", "name"]
        ],
        "text-font": ["Montserrat Regular"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          8, 9,
          14, 13
        ],
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "__LABEL_WATER__",
        "text-halo-color": "__LABEL_HALO__",
        "text-halo-width": 1.3
      }
    },
    {
      "id": "smap-poi-dots",
      "type": "circle",
      "source": "smap-vietnam",
      "source-layer": "poi",
      "minzoom": 12,
      "paint": {
        "circle-color": "__POI_DOT__",
        "circle-opacity": 0.88,
        "circle-radius": [
          "interpolate", ["linear"], ["zoom"],
          12, 1.6, 14, 3.2
        ],
        "circle-stroke-color": "__POI_STROKE__",
        "circle-stroke-width": 1
      }
    },
    {
      "id": "smap-poi-labels",
      "type": "symbol",
      "source": "smap-vietnam",
      "source-layer": "poi",
      "minzoom": 15,
      "filter": ["has", "name"],
      "layout": {
        "text-field": [
          "coalesce",
          ["get", "name:vi"],
          ["get", "name"]
        ],
        "text-font": ["Montserrat Regular"],
        "text-size": 10,
        "text-offset": [0, 1.1],
        "text-padding": 2,
        "text-max-width": 8,
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "__LABEL_POI__",
        "text-halo-color": "__LABEL_HALO__",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "smap-house-number-dots",
      "type": "circle",
      "source": "smap-vietnam",
      "source-layer": "housenumber",
      "minzoom": 14,
      "paint": {
        "circle-color": "__HOUSE_NUMBER_DOT__",
        "circle-opacity": 0.56,
        "circle-radius": 1.25
      }
    },
    {
      "id": "smap-house-number-labels",
      "type": "symbol",
      "source": "smap-vietnam",
      "source-layer": "housenumber",
      "minzoom": 15,
      "filter": ["has", "housenumber"],
      "layout": {
        "text-field": ["get", "housenumber"],
        "text-font": ["Montserrat Regular"],
        "text-size": 8,
        "text-padding": 1,
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "__LABEL_SECONDARY__",
        "text-halo-color": "__LABEL_HALO__",
        "text-halo-width": 0.8
      }
    }
  ]
}
